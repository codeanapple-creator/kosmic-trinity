# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
SITE_URL=https://kosmictrinity.in

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── CCAvenue ───────────────────────────────────────────────────────────────────
CCAVENUE_MERCHANT_ID=your_merchant_id
CCAVENUE_ACCESS_CODE=your_access_code
CCAVENUE_WORKING_KEY=your_working_key
CCAVENUE_MODE=production          # "production" or "test"

# ── Google Calendar (service account) ─────────────────────────────────────────
# Create a service account at https://console.cloud.google.com/
# Enable the Google Calendar API, share your calendar with the service account email
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary        # or a specific calendar ID

# How many days ahead to schedule the placeholder session (admin can update later)
DEFAULT_SESSION_OFFSET_DAYS=7

# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────────
GMAIL_USER=kosmictrinity@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# ── Admin Dashboard ────────────────────────────────────────────────────────────
# Set a strong random token: openssl rand -hex 32
ADMIN_TOKEN=your_admin_token_here

# ── Stripe (international payments — optional) ─────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Razorpay (legacy — optional) ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_secret

# ── Session ────────────────────────────────────────────────────────────────────
SESSION_SECRET=run_openssl_rand_hex_32_and_paste_here
